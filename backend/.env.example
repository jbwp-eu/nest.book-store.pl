PORT=3003
# Bind address — 127.0.0.1 on production (Caddy reverse proxy); use 0.0.0.0 only if needed
# HOST=127.0.0.1

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=bookstore

JWT_SECRET=your_jwt_secret

PAGINATION_LIMIT=5

# Tax rate applied to items price (e.g. 0.15 = 15%)
TAX=0

# Optional — signed CloudFront URLs for aws/* image keys
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_BASE_URL=https://d8gge2z531r61.cloudfront.net/

# Optional — S3 upload (PATCH /products/:id)
# AWS_BUCKET_NAME_2=
# AWS_BUCKET_REGION_2=
# AWS_ACCESS_KEY_2=
# AWS_SECRET_KEY_2=
# CLOUDFRONT_DISTRIBUTION_ID=

STRIPE_SECRET_KEY_TEST_MODE=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST_MODE=whsec_...

# SMTP — purchase receipt email (webhook)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# DOMAIN=
# TO_1=
# TO_2=
# TO_3=

# Seeder admin user (npm run seed -- -i)
# ADMIN_PASSWORD=your_admin_password

# Rate limiting — login, register, contact, create-payment-intent (per IP)
# RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
# RATE_LIMIT_SENSITIVE_MAX=20

# Store map — same address as gql.book-store.com.pl
STORE_ADDRESS=Rondo Dmowskiego 10, 00-590 Warszawa, Poland
# Geocoding key (server-side, same env name as gql)
# GOOGLE_MAPS_API_KEY_geocoding=

# Optional — npm run chat:test (default: http://localhost:PORT)
# CHAT_TEST_BASE_URL=http://localhost:3004
