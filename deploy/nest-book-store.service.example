[Unit]
Description=nest.book-store.pl NestJS API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/nest-book-store/current/backend
Environment=NODE_ENV=production
EnvironmentFile=/var/www/nest-book-store/shared/.env.production
ExecStart=/usr/bin/node dist/src/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
