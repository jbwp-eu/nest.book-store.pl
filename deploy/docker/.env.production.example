# Copy to /var/www/nest-book-store/shared/.env.production (chmod 600)
# DB_HOST is overridden to "postgres" by docker-compose.yml

PORT=3004
HOST=0.0.0.0

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=bookstore
DB_PASSWORD=change_me_strong_password
DB_NAME=bookstore

JWT_SECRET=change_me_long_random_secret
PAGINATION_LIMIT=5
TAX=0
CURRENCY=PLN

# ovh = nest.book-store.com.pl | aws = nest.book-store.pl
DEPLOY_TARGET=aws
STRIPE_SECRET_KEY_TEST_MODE_AWS=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST_MODE_AWS=whsec_...
# Optional second account (not required when DEPLOY_TARGET=aws)
# STRIPE_SECRET_KEY_TEST_MODE_OVH=sk_test_...
# STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=whsec_...

# Optional — S3 / CloudFront (product images)
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_BASE_URL=https://d8gge2z531r61.cloudfront.net/
# AWS_BUCKET_NAME_2=
# AWS_BUCKET_REGION_2=
# AWS_ACCESS_KEY_2=
# AWS_SECRET_KEY_2=
# CLOUDFRONT_DISTRIBUTION_ID=

# Optional — SMTP / SQS
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# DOMAIN=
# TO_1=
# ORDER_CONFIRMATION_QUEUE_URL=
# AWS_REGION=eu-central-1

STORE_ADDRESS=Rondo Dmowskiego 10, 00-590 Warszawa, Poland
# GOOGLE_MAPS_API_KEY_geocoding=

# Seed (docker compose exec nest-api node dist/src/scripts/seed.js)
# ADMIN_PASSWORD=
