# Dev server (Vite)
VITE_PORT=5173

# ovh = nest.book-store.com.pl | aws = nest.book-store.pl
VITE_DEPLOY_TARGET=ovh

# Nest backend — global prefix /api (dev / test)
VITE_BACKEND_URL_TEST_MODE=http://localhost:3004/api

# Production API (used after vite build; pick by VITE_DEPLOY_TARGET)
VITE_BACKEND_URL_OVH=https://nest.book-store.com.pl/api
VITE_BACKEND_URL_AWS=https://nest.book-store.pl/api

# CloudFront base URL for product images (no trailing slash)
VITE_ASSET_URL=https://d8gge2z531r61.cloudfront.net

VITE_APP_NAME=BookStore

# Default UI locale: pl | en
VITE_LANGUAGE=pl

# Tax rate from backend config (e.g. 0 = 0%)
VITE_TAX=0

# Stripe publishable keys (test mode) — must match backend DEPLOY_TARGET
VITE_STRIPE_PUBLISHABLE_KEY_TEST_MODE_OVH=pk_test_your_ovh_key_here
VITE_STRIPE_PUBLISHABLE_KEY_TEST_MODE_AWS=pk_test_your_aws_key_here

# Frontend origin for Stripe redirect after payment (dev / test)
VITE_STRIPE_CONFIRMPAYMENT_URL_TEST_MODE=http://localhost:5173

# Production origin (used after vite build)
VITE_STRIPE_CONFIRMPAYMENT_URL_OVH=https://nest.book-store.com.pl
VITE_STRIPE_CONFIRMPAYMENT_URL_AWS=https://nest.book-store.pl

# Google Maps (same keys as gql.book-store.com.pl frontend)
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
